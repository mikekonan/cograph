# OS junk
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# Agent-local instructions and launch config
AGENTS.md
CLAUDE.md
**/AGENTS.md
agents/claude.md
.claude/

# Internal project planning notes.
# NOTE: `/docs/` used to be ignored here as a scratch area for internal
# planning. It is now the published documentation site (docs/ -> cograph.cc)
# and must be tracked — do not re-add it.
PLAN.md
web/README.md
backend/integration_tests/README.md

# Generated: docs/scripts/sync-tokens.mjs derives these from the app's
# design tokens on every docs build, so they are never committed.
docs/.vitepress/theme/tokens.generated.css
docs/.vitepress/theme/mermaid-palette.json
docs/.vitepress/cache/
docs/.vitepress/dist/

# Claude Code — per-user preferences, worktrees, and local permissions
.claude/*.local.*
.claude/settings.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Codex CLI — per-user local hooks + feature flags (point at host-only tools)
.codex/*.local.json
.codex/config.toml

# Ralph-loop — per-session task specs
.ralph/

# Codexpotter — per-user knowledge-base notes / session logs
.codexpotter/

# Entire — per-user session tracker, never checked in
.entire/

# Node — repo-wide, so every workspace (web/, docs/, …) is covered rather
# than relying on a per-directory .gitignore that a new one would not have.
node_modules/

# TS incremental build cache
*.tsbuildinfo

# Logs
*.log

# Playwright MCP runtime artefacts (screenshots, snapshots, console logs)
.playwright-mcp/

# Env / secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/

# Cograph runtime + local-dev artefacts
# local checkouts / runtime state
.cograph/
# playwright runner state
.playwright-cli
.playwright-cli/
# local-dev config with secrets — use config.example.yaml as template
/config.yaml
backend/config.yaml

# Session debug artefacts
# root-level screenshots from preview/playwright sessions
/*.png
/SMOKE_REPORT*.md
/CHECKER_NOTES.md
/FE_TOGGLE_REPORT.md
/*_BRINGUP_REPORT.md
.coverage
# Wiki / MCP payload dumps captured from a running instance for debugging.
# These mirror the content of whatever repository was indexed, so they must
# never reach a commit — the repository being indexed is not necessarily public.
/*_wiki_full.md
/*_wiki_compact.md
/*_mcp_served.md
